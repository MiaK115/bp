        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/BPCalculator/bin/Debug/net6.0/BPCalculator.dll",
            "args": [],
            "cwd": "${workspaceFolder}/BPCalculator",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "dotnetRunMessages": true,
            "launchBrowser": {
                "enabled": false,
                "args": "http://localhost:5000",
                "windows": {
                    "command": "cmd.exe",
                    "args": "/C start http://localhost:5000"
                }
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}